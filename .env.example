# ==========================================
# DataPulse Live - Environment Configuration
# ==========================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_ORDERS_TOPIC=raw_orders
KAFKA_DEAD_LETTER_TOPIC=dead_letter_orders
KAFKA_CONSUMER_GROUP=datapulse-spark-consumer
KAFKA_AUTO_OFFSET_RESET=latest

# PostgreSQL Data Warehouse Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datapulse_warehouse
POSTGRES_USER=datapulse_user
POSTGRES_PASSWORD=datapulse_secure_password
POSTGRES_MAX_CONNECTIONS=20

# Generator Settings
GENERATOR_RATE_PER_SECOND=5.0
GENERATOR_BURST_PROBABILITY=0.08
GENERATOR_ERROR_INJECTION_RATE=0.04
GENERATOR_DUPLICATE_RATE=0.02

# Spark Streaming Configuration
SPARK_APP_NAME=DataPulse-StreamProcessor
SPARK_MASTER=local[*]
SPARK_BATCH_DURATION_SECONDS=3
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints/datapulse

# Airflow Configuration
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_CONN_POSTGRES_WAREHOUSE=postgresql+psycopg2://datapulse_user:datapulse_secure_password@postgres:5432/datapulse_warehouse

# Streamlit Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_AUTO_REFRESH_INTERVAL=3
